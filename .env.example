SECRET_KEY=replace-with-a-long-random-string  # Example: openssl rand -base64 48 (do not change after storing OLTs)
ADMIN_USER=admin
ADMIN_PASS=change-this
TZ_NAME=Asia/Jakarta
AUTOSAVE_TIME=02:30                      # Daily configuration save time in TZ_NAME
POLL_INTERVAL=60                         # ONU status polling interval in seconds
CLI_RX_EVERY=10                          # Read CLI signal levels every N polls (default 10 = about 10 minutes)
# HTTPS_ONLY=true                        # Enable when behind an HTTPS reverse proxy
GRAPH_INTERVAL=300                       # Seconds between OLT graph samples
# GRAPH_RETENTION_DAYS=14
TELNET_IDLE_CLOSE=90                     # Seconds; must be lower than the OLT "line telnet idle-timeout"
